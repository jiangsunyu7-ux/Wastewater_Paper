<mxfile host="app.diagrams.net" version="24.7.17"><diagram name="Executed Stage 3B workflow" id="stage3b"><mxGraphModel page="1" pageWidth="1280" pageHeight="990"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="qa" value="Frozen QA-v3 data: 3 source + 10 target SiteIDs; daily m3&lt;br&gt;Published Good, nonnegative, nonconflicting; real zero retained&lt;br&gt;Calendar gaps preserved; retrospective quality filtering, facility identity unresolved" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5fa;strokeColor=#33566b;fontSize=15;fontFamily=Arial;"><mxGeometry as="geometry" x="140" y="25" width="1000" height="80" /></mxCell><mxCell id="proxy" value="Source selection proxies: 2016-2020 only&lt;br&gt;B30: leave-one-source-out pseudo-deployments in 2021&lt;br&gt;Fixed alpha / lambda grids; equal-source weights" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5fa;strokeColor=#33566b;fontSize=15;fontFamily=Arial;"><mxGeometry as="geometry" x="25" y="155" width="550" height="85" /></mxCell><mxCell id="source" value="Final shared models: source 2016-2021 only&lt;br&gt;Three fixed source SiteIDs; no target training&lt;br&gt;Compact direct / residual Ridge; no new GRU fitting" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5fa;strokeColor=#33566b;fontSize=15;fontFamily=Arial;"><mxGeometry as="geometry" x="705" y="155" width="550" height="85" /></mxCell><mxCell id="history" value="Target initial calibration: 30 / 90 / 180 calendar days&lt;br&gt;Six compact lag-volume / availability features; allowed-history median scale&lt;br&gt;All fitting labels end at or before the calibration cutoff" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5fa;strokeColor=#33566b;fontSize=15;fontFamily=Arial;"><mxGeometry as="geometry" x="140" y="295" width="1000" height="80" /></mxCell><mxCell id="tune" value="Legal parameter choice before deployment&lt;br&gt;B90/180: purged chronological prefix validation&lt;br&gt;B30: source-assisted held-source validation&lt;br&gt;Bias fitted on fold training labels only" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5fa;strokeColor=#33566b;fontSize=15;fontFamily=Arial;"><mxGeometry as="geometry" x="25" y="430" width="550" height="100" /></mxCell><mxCell id="freeze" value="Freeze calibration scale, models and corrections&lt;br&gt;3 residual families: local / shared / shared + bias&lt;br&gt;Each keeps lambda=1 and selected-lambda policies&lt;br&gt;Persistence + weekly + 3 direct-Ridge controls" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5fa;strokeColor=#33566b;fontSize=15;fontFamily=Arial;"><mxGeometry as="geometry" x="705" y="430" width="550" height="100" /></mxCell><mxCell id="deploy" value="Actual deployment forecasts: 4 reused 2022-2023 windows + fixed October 2023 window&lt;br&gt;60 daily origins per window; target = origin+1 or origin+3 day&lt;br&gt;Newly known lag inputs allowed; no deployment-label updates&lt;br&gt;Raw predictions primary; max(0, prediction) uniformly secondary" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5fa;strokeColor=#33566b;fontSize=15;fontFamily=Arial;"><mxGeometry as="geometry" x="140" y="585" width="1000" height="95" /></mxCell><mxCell id="eval" value="Matched dates across all 11 policies and all budgets; failures retained&lt;br&gt;Per-SiteID MAE/RMSE and skill; equal-SiteID summaries&lt;br&gt;Synchronous 14-day calendar blocks + SiteID clusters (7/28-day sensitivity)&lt;br&gt;B30 shared residual + bias co-primary horizons: multiplicity-adjusted intervals" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5fa;strokeColor=#33566b;fontSize=15;fontFamily=Arial;"><mxGeometry as="geometry" x="140" y="735" width="1000" height="100" /></mxCell><mxCell id="archive" value="Saved predictions, diagnostics, parameter grids, figures and evidence audit&lt;br&gt